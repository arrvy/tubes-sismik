    1:				; =================================================================
    2:				; BASIC CALCULATOR 8051 (MODULAR + "ANS" CHAINING FEATURE)
    3:				; Konfigurasi PINOUT TERBARU:
    4:				; LCD Data = P1, LCD Ctrl = P3, Keypad = P2
    5:				; =================================================================
    6:
    7:				; =================================================================
    8:				; MODULAR HARDWARE CONFIGURATION
    9:				; =================================================================
   10:				; --- Konfigurasi LCD ---
   11:		D      0090	LCD_DAT     EQU P1      ; Port Data LCD (D0-D7)
   12:		B      00B2	LCD_RS      EQU P3.2    ; Pin RS pada LCD
   13:		B      00B3	LCD_EN      EQU P3.3    ; Pin EN pada LCD
   14:
   15:				; --- Konfigurasi Port Keypad Matriks ---
   16:		D      00A0	KEY_PORT    EQU P2      ; Base Port untuk Keypad
   17:		B      00A0	COL1        EQU P2.0    ; Keypad Kolom 1
   18:		B      00A1	COL2        EQU P2.1    ; Keypad Kolom 2
   19:		B      00A2	COL3        EQU P2.2    ; Keypad Kolom 3
   20:		B      00A3	COL4        EQU P2.3    ; Keypad Kolom 4
   21:		B      00A4	ROW1        EQU P2.4    ; Keypad Baris 1
   22:		B      00A5	ROW2        EQU P2.5    ; Keypad Baris 2
   23:		B      00A6	ROW3        EQU P2.6    ; Keypad Baris 3
   24:		B      00A7	ROW4        EQU P2.7    ; Keypad Baris 4
   25:
   26:				; --- Flag Internal State ---
   27:		B      00B7	NOVONUM     EQU P3.7    ; Flag: HIGH saat menulis angka kedua
   28:		B      00B6	NOVODIG     EQU P3.6    ; Flag: HIGH saat digit pertama sudah ditulis
   29:		B      00B5	ANS_FLAG    EQU P3.5    ; Flag: HIGH jika hasil hitungan sedang tampil di layar
   30:				; =================================================================
   31:
   32:		N      0000	ORG 00H
   33:	  0000	01 40		    AJMP START
   34:
   35:		N      0040	    ORG 40H
   36:	  0040			START:
   37:	  0040	71 22		    ACALL INITIALYZE
   38:	  0042	80 00		    SJMP L1
   39:
   40:				; =================================================================
   41:				; KEYPAD SCANNING (4x4 Matrix)
   42:				; =================================================================
   43:	  0044			L1:

