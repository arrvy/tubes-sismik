  477:				; =================================================================
  478:				; RUTIN PEMBALIK BIT (BIT REVERSAL)
  479:				; Memutar urutan bit (D0 jadi D7, D1 jadi D6, dst)
  480:				; =================================================================
  481:	  02F2			REVERSE_BITS:
  482:	  02F2	8F 3E		    MOV 3EH, R7         ; Backup R7 ke RAM agar tidak merusak loop teks (OVERFLOW)
  483:	  02F4	8E 3F		    MOV 3FH, R6         ; Backup R6 ke RAM
  484:
  485:	  02F6	7F 08		    MOV R7, #8          ; Lakukan pergeseran sebanyak 8 kali (8-bit)
  486:	  02F8	7E 00		    MOV R6, #0          ; R6 sebagai penampung data yang sudah dibalik
  487:	  02FA			REV_LOOP:
  488:	  02FA	13		    RRC A               ; Geser bit paling kanan (LSB) dari A ke Carry Flag
  489:	  02FB	CE		    XCH A, R6           ; Tukar nilai A dengan R6 sementara
  490:	  02FC	33		    RLC A               ; Masukkan Carry Flag tadi ke bit kanan (R6) sambil digeser ke kiri
  491:	  02FD	CE		    XCH A, R6           ; Tukar kembali

