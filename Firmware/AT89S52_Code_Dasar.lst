    1:				; =================================================================
    2:				; BASIC CALCULATOR 8051 (REFINED & PIN-MODULAR VERSION)
    3:				; Fitur:
    4:				; - Operator langsung tampil setelah angka pertama (Augend)
    5:				; - Tombol R4 C1 berfungsi penuh sebagai ON/C (Clear/Reset All)
    6:				; - PIN MODULAR: Definisi port/pin I/O terpusat di atas.
    7:				; =================================================================
    8:
    9:				; =================================================================
   10:				; MODULAR HARDWARE CONFIGURATION (UBAH PIN DI SINI)
   11:				; =================================================================
   12:				; --- Konfigurasi LCD ---
   13:		D      0090	LCD_DAT     EQU P1      ; Port Data LCD (D0-D7)
   14:		B      00B2	LCD_RS      EQU P3.2    ; Pin RS pada LCD
   15:		B      00B3	LCD_EN      EQU P3.3    ; Pin EN pada LCD
   16:
   17:				; --- Konfigurasi Port Keypad Matriks ---
   18:		D      00A0	KEY_PORT    EQU P2      ; Base Port untuk Keypad
   19:		B      00A0	COL1        EQU P2.0    ; Keypad Kolom 1
   20:		B      00A1	COL2        EQU P2.1    ; Keypad Kolom 2
   21:		B      00A2	COL3        EQU P2.2    ; Keypad Kolom 3
   22:		B      00A3	COL4        EQU P2.3    ; Keypad Kolom 4
   23:		B      00A4	ROW1        EQU P2.4    ; Keypad Baris 1
   24:		B      00A5	ROW2        EQU P2.5    ; Keypad Baris 2
   25:		B      00A6	ROW3        EQU P2.6    ; Keypad Baris 3
   26:		B      00A7	ROW4        EQU P2.7    ; Keypad Baris 4
   27:
   28:				; --- Flag Internal State (Meminjam pin P2 yang tidak terpakai) ---
   29:		B      00B7	NOVONUM     EQU P3.7    ; Flag: HIGH saat menulis angka kedua
   30:		B      00B6	NOVODIG     EQU P3.6    ; Flag: HIGH saat digit pertama sudah ditulis
   31:				; =================================================================
   32:
   33:		N      0000	    ORG 00H
   34:	  0000	01 40		    AJMP START
   35:
   36:		N      0040	    ORG 40H
   37:	  0040			START:
   38:	  0040	51 BB		    ACALL INITIALYZE
   39:	  0042	80 00		    SJMP L1             ; Langsung mulai scanning keypad
   40:
   41:				; =================================================================
   42:				; KEYPAD SCANNING (4x4 Matrix)
   43:				; =================================================================

