  814:				; =================================================================
  815:				; RUTIN PEMBALIK BIT (BIT REVERSAL)
  816:				; Memutar urutan bit (D0 jadi D7, D1 jadi D6, dst)
  817:				; =================================================================
  818:	  05A7			REVERSE_BITS:
  819:	  05A7	8F 3E		    MOV 3EH, R7         ; Backup R7 ke RAM agar tidak merusak loop teks (OVERFLOW)
  820:	  05A9	8E 3F		    MOV 3FH, R6         ; Backup R6 ke RAM
  821:
  822:	  05AB	7F 08		    MOV R7, #8          ; Lakukan pergeseran sebanyak 8 kali (8-bit)
  823:	  05AD	7E 00		    MOV R6, #0          ; R6 sebagai penampung data yang sudah dibalik
  824:	  05AF			REV_LOOP:
  825:	  05AF	13		    RRC A               ; Geser bit paling kanan (LSB) dari A ke Carry Flag
  826:	  05B0	CE		    XCH A, R6           ; Tukar nilai A dengan R6 sementara
  827:	  05B1	33		    RLC A               ; Masukkan Carry Flag tadi ke bit kanan (R6) sambil digeser ke kiri

ASEM-51 V1.3                                        Copyright (c) 2002 by W.W. Heinz                                         PAGE 16



 Line  I  Addr  Code            Source

  828:	  05B2	CE		    XCH A, R6           ; Tukar kembali
  829:	  05B3	DF FA		    DJNZ R7, REV_LOOP   ; Ulangi sampai 8 bit selesai dipindah
  830:
  831:	  05B5	EE		    MOV A, R6           ; Pindahkan hasil akhir (yang sudah terbalik) ke Akumulator
  832:	  05B6	AF 3E		    MOV R7, 3EH         ; Kembalikan nilai asli R7
  833:	  05B8	AE 3F		    MOV R6, 3FH         ; Kembalikan nilai asli R6
  834:	  05BA	22		    RET
  835:
