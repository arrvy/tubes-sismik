 Line  I  Addr  Code            Source

  660:	  0421	8E 3F		    MOV 3FH, R6         ; Backup R6 ke RAM
  661:
  662:	  0423	7F 08		    MOV R7, #8          ; Lakukan pergeseran sebanyak 8 kali (8-bit)
  663:	  0425	7E 00		    MOV R6, #0          ; R6 sebagai penampung data yang sudah dibalik
  664:	  0427			REV_LOOP:
  665:	  0427	13		    RRC A               ; Geser bit paling kanan (LSB) dari A ke Carry Flag
  666:	  0428	CE		    XCH A, R6           ; Tukar nilai A dengan R6 sementara
  667:	  0429	33		    RLC A               ; Masukkan Carry Flag tadi ke bit kanan (R6) sambil digeser ke kiri
  668:	  042A	CE		    XCH A, R6           ; Tukar kembali
  669:	  042B	DF FA		    DJNZ R7, REV_LOOP   ; Ulangi sampai 8 bit selesai dipindah
  670:
  671:	  042D	EE		    MOV A, R6           ; Pindahkan hasil akhir (yang sudah terbalik) ke Akumulator
  672:	  042E	AF 3E		    MOV R7, 3EH         ; Kembalikan nilai asli R7
