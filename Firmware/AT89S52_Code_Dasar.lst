  739:	  04DD	24 30		    ADD A, #30H
  740:	  04DF	F8		    MOV R0, A
  741:	  04E0	12 04 F8	    LCALL DISPLAY
  742:	  04E3	22		    RET
  743:				; =================================================================
  744:				; RUTIN PEMBALIK BIT (BIT REVERSAL)
  745:				; Memutar urutan bit (D0 jadi D7, D1 jadi D6, dst)
  746:				; =================================================================
  747:	  04E4			REVERSE_BITS:
  748:	  04E4	8F 3E		    MOV 3EH, R7         ; Backup R7 ke RAM agar tidak merusak loop teks (OVERFLOW)
  749:	  04E6	8E 3F		    MOV 3FH, R6         ; Backup R6 ke RAM
  750:
  751:	  04E8	7F 08		    MOV R7, #8          ; Lakukan pergeseran sebanyak 8 kali (8-bit)
  752:	  04EA	7E 00		    MOV R6, #0          ; R6 sebagai penampung data yang sudah dibalik
  753:	  04EC			REV_LOOP:
  754:	  04EC	13		    RRC A               ; Geser bit paling kanan (LSB) dari A ke Carry Flag
  755:	  04ED	CE		    XCH A, R6           ; Tukar nilai A dengan R6 sementara
  756:	  04EE	33		    RLC A               ; Masukkan Carry Flag tadi ke bit kanan (R6) sambil digeser ke kiri
  757:	  04EF	CE		    XCH A, R6           ; Tukar kembali
  758:	  04F0	DF FA		    DJNZ R7, REV_LOOP   ; Ulangi sampai 8 bit selesai dipindah
  759:
  760:	  04F2	EE		    MOV A, R6           ; Pindahkan hasil akhir (yang sudah terbalik) ke Akumulator
  761:	  04F3	AF 3E		    MOV R7, 3EH         ; Kembalikan nilai asli R7
  762:	  04F5	AE 3F		    MOV R6, 3FH         ; Kembalikan nilai asli R6
  763:	  04F7	22		    RET
  764:
  765:				; =================================================================
  766:				; DRIVER LCD (Updated dengan Pembalik Bit)
  767:				; =================================================================
  768:	  04F8			DISPLAY:
  769:	  04F8	E8		    MOV A, R0           ; 1. Ambil data asli dari R0
  770:	  04F9	12 04 E4	    LCALL REVERSE_BITS  ; 2. Panggil rutin pembalik bit
  771:	  04FC	F5 90		    MOV LCD_DAT, A      ; 3. Kirim data yang SUDAH DIBALIK ke Port 1

