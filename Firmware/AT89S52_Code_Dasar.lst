    1:				; =================================================================
    2:				; BASIC CALCULATOR 8051 (MODULAR + "ANS" CHAINING FEATURE)
    3:				; Konfigurasi PINOUT TERBARU:
    4:				; LCD Data = P1, LCD Ctrl = P3, Keypad = P2
    5:				; =================================================================
    6:
    7:				; =================================================================
    8:				; MODULAR HARDWARE CONFIGURATION
    9:				; =================================================================
   10:				; --- Konfigurasi LCD ---
   11:		D      0090	LCD_DAT     EQU P1      ; Port Data LCD (D0-D7)
   12:		B      00B2	LCD_RS      EQU P3.2    ; Pin RS pada LCD
   13:		B      00B3	LCD_EN      EQU P3.3    ; Pin EN pada LCD
   14:
   15:				; --- Konfigurasi Port Keypad Matriks ---
   16:		D      00A0	KEY_PORT    EQU P2      ; Base Port untuk Keypad
   17:		B      00A0	COL1        EQU P2.0    ; Keypad Kolom 1
   18:		B      00A1	COL2        EQU P2.1    ; Keypad Kolom 2
   19:		B      00A2	COL3        EQU P2.2    ; Keypad Kolom 3
   20:		B      00A3	COL4        EQU P2.3    ; Keypad Kolom 4
   21:		B      00A4	ROW1        EQU P2.4    ; Keypad Baris 1
   22:		B      00A5	ROW2        EQU P2.5    ; Keypad Baris 2
   23:		B      00A6	ROW3        EQU P2.6    ; Keypad Baris 3
   24:		B      00A7	ROW4        EQU P2.7    ; Keypad Baris 4
   25:
   26:				; --- Flag Internal State ---
   27:		B      0000	NOVONUM     EQU 20H.0   ; Flag: HIGH saat menulis angka kedua (Bit RAM Internal)
   28:		B      0001	NOVODIG     EQU 20H.1   ; Flag: HIGH saat digit pertama sudah ditulis (Bit RAM Internal)
   29:		B      0002	ANS_FLAG    EQU 20H.2   ; Flag: HIGH jika hasil hitungan sedang tampil di layar (Bit RAM Internal)
   30:
   31:				; --- Alokasi RAM 16-Bit (Max 1024) ---
   32:		N      0030	NUM1_H      EQU 30H     ; Angka 1 High Byte
   33:		N      0031	NUM1_L      EQU 31H     ; Angka 1 Low Byte
   34:		N      0032	NUM2_H      EQU 32H     ; Angka 2 High Byte
   35:		N      0033	NUM2_L      EQU 33H     ; Angka 2 Low Byte
   36:		N      0034	RES_H       EQU 34H     ; Hasil High Byte
   37:		N      0035	RES_L       EQU 35H     ; Hasil Low Byte
   38:		N      0036	REM_H       EQU 36H     ; Sisa Bagi High Byte
   39:		N      0037	REM_L       EQU 37H     ; Sisa Bagi Low Byte
   40:				; =================================================================
   41:
   42:		N      0000	ORG 00H
   43:	  0000	01 40		    AJMP START

