  741:	  04D8			REVERSE_BITS:
  742:	  04D8	8F 3E		    MOV 3EH, R7         ; Backup R7 ke RAM agar tidak merusak loop teks (OVERFLOW)
  743:	  04DA	8E 3F		    MOV 3FH, R6         ; Backup R6 ke RAM
  744:
  745:	  04DC	7F 08		    MOV R7, #8          ; Lakukan pergeseran sebanyak 8 kali (8-bit)
  746:	  04DE	7E 00		    MOV R6, #0          ; R6 sebagai penampung data yang sudah dibalik
  747:	  04E0			REV_LOOP:
  748:	  04E0	13		    RRC A               ; Geser bit paling kanan (LSB) dari A ke Carry Flag
  749:	  04E1	CE		    XCH A, R6           ; Tukar nilai A dengan R6 sementara
  750:	  04E2	33		    RLC A               ; Masukkan Carry Flag tadi ke bit kanan (R6) sambil digeser ke kiri
  751:	  04E3	CE		    XCH A, R6           ; Tukar kembali
  752:	  04E4	DF FA		    DJNZ R7, REV_LOOP   ; Ulangi sampai 8 bit selesai dipindah
  753:
  754:	  04E6	EE		    MOV A, R6           ; Pindahkan hasil akhir (yang sudah terbalik) ke Akumulator
  755:	  04E7	AF 3E		    MOV R7, 3EH         ; Kembalikan nilai asli R7
  756:	  04E9	AE 3F		    MOV R6, 3FH         ; Kembalikan nilai asli R6
  757:	  04EB	22		    RET
  758:
  759:				; =================================================================
  760:				; DRIVER LCD (Updated dengan Pembalik Bit)
  761:				; =================================================================
  762:	  04EC			DISPLAY:
  763:	  04EC	E8		    MOV A, R0           ; 1. Ambil data asli dari R0
  764:	  04ED	12 04 D8	    LCALL REVERSE_BITS  ; 2. Panggil rutin pembalik bit
  765:	  04F0	F5 90		    MOV LCD_DAT, A      ; 3. Kirim data yang SUDAH DIBALIK ke Port 1
  766:	  04F2	D2 B2		    SETB LCD_RS
  767:	  04F4	D2 B3		    SETB LCD_EN
  768:	  04F6	12 05 74	    LCALL DELAY
  769:	  04F9	C2 B3		    CLR LCD_EN
  770:	  04FB	22		    RET
  771:

