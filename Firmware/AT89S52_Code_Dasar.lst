    1:				; =================================================================
    2:				; BASIC CALCULATOR 8051 (REFINED VERSION)
    3:				; Fitur:
    4:				; - Operator langsung tampil setelah angka pertama (Augend)
    5:				; - Tombol R4 C1 berfungsi penuh sebagai ON/C (Clear/Reset All)
    6:				; =================================================================
    7:
    8:				; --- DEKLARASI PIN I/O & FLAG ---
    9:		B      00A1	RS          EQU P2.1    ; RS pada LCD
   10:		B      00A2	EN          EQU P2.2    ; EN pada LCD
   11:		B      00A7	NOVONUM     EQU P2.7    ; P2.7 HIGH saat menulis angka kedua
   12:		B      00A6	NOVODIG     EQU P2.6    ; P2.6 HIGH saat digit pertama sudah ditulis
   13:
   14:		N      0000	    ORG 00H
   15:	  0000	01 40		    AJMP START
   16:
   17:		N      0040	    ORG 40H
   18:	  0040			START:
   19:	  0040	51 BB		    ACALL INITIALYZE
   20:	  0042	80 00		    SJMP L1             ; Langsung mulai scanning keypad
   21:
